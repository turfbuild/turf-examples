# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is git-ignored (it holds account-specific / secret values).

# Required: your Scalr account hostname.
scalr_hostname = "example.scalr.io"

# Your account ID (acc-...). For LOCAL provider runs Scalr can't always infer it, so
# set it here (or export SCALR_ACCOUNT_ID). Leave commented only if a single-account
# token makes inference unambiguous.
# scalr_account_id = "acc-xxxxxxxxxx"

# Optional: a GitHub token so Scalr can source the OPA policies in ../policies over
# VCS. Leave commented to skip the VCS provider + policy group — the environment and
# workspace are still created.
# vcs_token = "ghp_xxxxxxxxxxxx"

# The environment + workspace names default to turf-demo / turf-scalr-chat.
# environment_name    = "turf-demo"
# chat_workspace_name = "turf-scalr-chat"
