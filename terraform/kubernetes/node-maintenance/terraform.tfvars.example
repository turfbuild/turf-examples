# Copy this file to terraform.tfvars and customize values

# kubeconfig_path    = "~/.kube/config"
kubeconfig_context = "kind-aicr-1" # the cluster use-cases/datacenter/aicr-stack creates

# The node this configuration maintains.
node = "aicr-1-worker"

# Put the node in maintenance by naming it here; empty the set to put it back
# in service.
maintenance = []

# drain_flags = ["--ignore-daemonsets", "--delete-emptydir-data", "--timeout=10m"]
