# Copy to terraform.tfvars to override. Every variable has a default.

# aws_region    = "us-west-2"
# name_prefix   = "turf-k3s"
# instance_type = "t3.small"
# agent_count   = 1
# k3s_version   = "v1.36.4+k3s1"

# By default the security group admits only this machine's public address, as
# checkip.amazonaws.com reports it. Set a wider range if you run from behind a
# NAT whose egress address differs, or from more than one machine.
# operator_cidr = "203.0.113.7/32"

# message = "Hosts by Terraform, k3s by Ansible, this object by Terraform again."
