# The AICR bundle, installed on a cluster that already exists.
#
# ../aicr-stack creates a kind cluster and fills it in one configuration. This
# one is the other half of that story, the shape a management cluster runs:
# the workload cluster is somebody's to provision (Cluster API, a cloud's
# console, another Terraform module), and the runtime is installed on it from
# outside, by name. Everything under ../aicr-stack/bundle is generated by
# `aicr bundle --deployer terraform`; this directory adds only the provider
# and the cluster's name.

module "stack" {
  source = "../aicr-stack/bundle"

  # Nothing in the bundle connects with this. It is the containment keeper:
  # point the stack at another cluster and every release is replaced there,
  # not adopted by a cluster that has never seen it.
  cluster_keepers = var.cluster_name
}
